# generated code is never committed (D6)
/target
**/target

# a built binary is an artifact, and tools/guard-no-game-files.py refuses to
# commit a .exe at all, so one can only ever show up as an untracked file here
*.exe

# Mode B raw material is regenerable; the evidence sheet is the artifact (MDD §4)
/re/exports/
/re/ghidra_projects/
/re/traces/*.tsv
/re/ctx/
# A copy of a game file is never committed, whatever it is called. re/binaries is
# a CHECKSUMMED working copy (see tools/verify-binaries.py): the .sha256 files are
# the artifact, the binaries beside them are not. Everything else in there is
# ignored, so a stray .xnb or .dll cannot slip in behind the .exe rule.
/re/binaries/*
!/re/binaries/*.sha256

# The install's own shapes. These never have a reason to appear here: the evidence
# sheet records Content paths and hashes, it does not carry the bytes.
/Content/
*.xnb
*.dll
*.pdb
*.wav
*.ogg
*.mp3
*.xwb
*.xsb

# xlsx is a view, never the store (D7)
**/*.xlsx

__pycache__/
*.pyc

# projected docs
/docs/generated/*
!/docs/generated/.gitkeep

# keep the committed trace hashes
!/re/traces/*.sha256
